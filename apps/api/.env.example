# Copy to .env for local development. On Vercel, add the same keys in Project → Settings → Environment Variables.

# --- Admin login (required in production) ---
ADMIN_EMAIL=admin@elite.app
ADMIN_PASSWORD=change-me
# Any long random string, used to sign login tokens
AUTH_SECRET=change-me-to-a-long-random-string

# --- Database (Supabase) ---
# Use the *Transaction pooler* string (port 6543) from Supabase → Connect.
# Replace [YOUR-DATABASE-PASSWORD]; if the password has special characters (@ # / ? etc.), URL-encode them.
DATABASE_URL=postgresql://postgres.<project-ref>:[YOUR-DATABASE-PASSWORD]@aws-1-<region>.pooler.supabase.com:6543/postgres

# --- Frontend URL(s) allowed to call the API (comma-separated) ---
WEB_ORIGIN=http://localhost:3000

# --- AI agents ---
# Without OPENAI_API_KEY the agents run in demo mode (scripted answers).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Change if you reach OpenAI through a proxy or an OpenAI-compatible provider.
OPENAI_BASE_URL=https://api.openai.com/v1

# --- GitHub (optional) ---
# Needed for private repositories and to avoid GitHub's 60 requests/hour limit.
GITHUB_TOKEN=

PORT=3001
